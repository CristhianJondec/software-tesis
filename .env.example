NODE_ENV=production
# Public URL of the app (http://localhost:3000 when running locally)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ADMIN
ADMIN_EMAIL=

# POSTGRES
# With docker compose this value is overridden to point at the "db" container.
DATABASE_URL=postgres://investfied:investfied@localhost:5433/investfied

# BETTER AUTH
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GOOGLE OAUTH (Better Auth provider, optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CLOUDFLARE R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# VAPI
NEXT_PUBLIC_VAPI_API_KEY=
NEXT_PUBLIC_ASSISTANT_ID=
VAPI_PRIVATE_API_KEY=
VAPI_SERVER_SECRET=

# Google Gemini API (embeddings and judge)
GEMINI_API_KEY=
# GEMINI_JUDGE_MODEL=gemini-3.8-flash

# ELEVENLABS (optional)
ELEVENLABS_API_KEY=

# Metrics dashboard: comma-separated emails allowed into /metrics
METRICS_OWNER_EMAILS=
